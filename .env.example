# Database (PostgreSQL + PostGIS)
POSTGRES_DB=bel_anpr
POSTGRES_USER=anpr_user
POSTGRES_PASSWORD=secure_password_change_me

# API Security
API_KEY=bel-anpr-2026-secret-key-change-in-production

# OSRM Routing (Yarmuk local router at 127.0.0.1:5000, or public fallback)
OSRM_BASE_URL=http://127.0.0.1:5000

# ANPR Models (paths relative to backend container)
VEHICLE_MODEL_PATH=/app/models/yolo26s.engine
PLATE_MODEL_PATH=/app/models/best_plate.engine
OCR_ENGINE=easyocr  # options: easyocr, friend

# Processing
FRAME_SKIP=3
MAX_CROPS_PER_TRACK=8
MIN_CROP_WIDTH=15
MIN_CROP_HEIGHT=30
ASPECT_RATIO_MIN=1.0
ASPECT_RATIO_MAX=7.0
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Alert Rules
MAX_PLAUSIBLE_SPEED_KMH=150
BLACKLIST_CHECK_ENABLED=true
IMPOSSIBLE_TRAVEL_CHECK_ENABLED=true

# Frontend
VITE_API_BASE=http://localhost:8088
VITE_OSRM_PROXY=/api/osrm